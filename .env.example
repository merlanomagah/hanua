# Notion internal integration secret (https://www.notion.so/my-integrations)
# Share each database with the integration, or it will return 404.
NOTION_TOKEN=

# Claude API key (https://console.anthropic.com) - powers "Ask Claude" and "Feed"
ANTHROPIC_API_KEY=

PORT=3000

# Pūtea's local API (bank spending via Akahu). Leave as-is if Pūtea runs on this Mac.
PUTEA_URL=http://127.0.0.1:3456
