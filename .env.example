# Hanua's settings for this Mac. Copy this file to .env (in the same folder) and fill in what you use.
# Never put .env in iCloud Drive or GitHub: it holds keys. Setting up a second Mac? Copy the other Mac's .env,
# not this example (on 8 Oct 2026 a Mac set up from this file ran with no keys; Hanua now says so on the desk).
# Lines left blank fall back to Hanua's own (or sample data). Most choices are also in Hanua Settings (the cog).

# ---- keys (secrets) ----
# Notion internal integration secret (notion.so/profile/integrations → Hanua). Connect each database to it.
NOTION_TOKEN=
# Claude API key (console.anthropic.com → API keys): Ask Claude, the Feed, meal ideas
ANTHROPIC_API_KEY=
# (ANTHROPIC_AUTH_TOKEN can stand in for the key; leave it out unless told to)
# which Claude model to use (blank: Hanua's choice)
CLAUDE_MODEL=

# ---- this Mac ----
# the port Hanua answers on: open http://localhost:PORT on this Mac
PORT=3000
# the shared room folder both Macs use (days, menus, stickies, plant, Settings); blank = data/room on this Mac only
ROOM_DATA="~/Library/Mobile Documents/com~apple~CloudDocs/Hanua"
# where the nightly backup goes, or off; blank = ~/Hanua backup. Hanua Settings → This Mac can switch it on and off
BACKUP_DIR=
# the sleep screen's PIN file (blank = data/lock.json); test copies use their own
LOCK_FILE=

# ---- money ----
# Pūtea's local API (bank spending via Akahu). Pūtea runs on the Mac mini; on the other Mac, its address there
PUTEA_URL=http://127.0.0.1:3456

# ---- Apple apps on this Mac ----
# 0 turns Apple Calendar and Reminders off (test copies do); blank = on
APPLE_CAL=
# which calendars show, and which are Work, by name, comma separated (Hanua Settings → Calendars does this too)
APPLE_CALENDARS=
APPLE_WORK_CALENDARS=
# the Reminders lists the desk uses (Desk Settings → Lists does this too)
REMINDERS_SHOPPING=
REMINDERS_LIST=

# ---- the room ----
# your town for the weather window (Open-Meteo, no key); Hanua Settings → Weather does this too. Kept out of the code
# because the repo is public
WEATHER_PLACE=

# ---- set by Hanua's own scripts (leave these out of .env) ----
# HANUA_MAIN=1 (start.sh: this is the real Hanua), HANUA_SAMPLE=1 (test copies), HANUA_PID_FILE
